# Copie para .env e ajuste. Nunca versione o arquivo .env.
POSTGRES_USER=logicost
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=logicost
POSTGRES_PORT=5432

# URL usada pelo backend (SQLAlchemy + psycopg)
DATABASE_URL=postgresql+psycopg://logicost:troque-esta-senha@localhost:5432/logicost

APP_ENV=development

# Docker Compose (serviço app): porta publicada e carga dos dados fictícios na subida
APP_PORT=8000
SEED_DEMO=true
